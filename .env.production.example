# Copy to `.env.production` on the server (chmod 600) and fill in every value.
# Generate secrets with: openssl rand -base64 36
NODE_ENV=production

# --- Domain ---
SITE_DOMAIN=honeytree.example.com
ACME_EMAIL=ops@example.com
WEB_ORIGIN=https://honeytree.example.com
API_ORIGIN=https://honeytree.example.com
NEXT_PUBLIC_API_URL=/api/v1

# --- PostgreSQL (internal only, never published) ---
POSTGRES_USER=honeytree
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=honeytree

# --- Secrets ---
SESSION_SECRET=CHANGE_ME
IP_HASH_SALT=CHANGE_ME

# --- Object storage: Cloudflare R2 (default) ---
# R2 dashboard > Manage API tokens > Object Read & Write. Endpoint is per account.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_BUCKET_PRIVATE=honeytree-private
S3_BUCKET_PUBLIC=honeytree-public
# Custom domain connected to the PUBLIC bucket (R2 > bucket > Settings > Custom Domains).
S3_PUBLIC_BASE_URL=https://media.honeytree.example.com

# --- Backups: a third, private bucket (R2 or any S3-compatible service) ---
BACKUP_BUCKET=honeytree-backups
# Leave the next three empty to reuse the S3_* credentials above.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14

# --- Alternative: self-hosted MinIO (with infra/docker-compose.minio.yml) ---
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://s3.honeytree.example.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://media.honeytree.example.com/honeytree-public
# MEDIA_DOMAIN=media.honeytree.example.com
# S3_DOMAIN=s3.honeytree.example.com
# MINIO_ROOT_USER=CHANGE_ME
# MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Mail (optional until email features exist) ---
SMTP_HOST=
SMTP_PORT=587

# --- Error tracking (optional; create a Sentry project and paste its DSN) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Worker ---
# "fix" repairs drifted counters nightly; "report" only logs them.
COUNTER_RECHECK_MODE=fix

# --- Deploy ---
# Command run once per deploy before the new API starts. Must be safe to run twice.
MIGRATE_COMMAND=pnpm --filter @honeytree/api exec prisma migrate deploy
