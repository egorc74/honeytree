# Set to "enabled" to serve the API from in-browser MSW mocks (no backend needed).
NEXT_PUBLIC_API_MOCKING=enabled
# Browser-side API base. Same-origin by default; the rewrite in next.config.mjs proxies /api to API_ORIGIN.
NEXT_PUBLIC_API_BASE=/api/v1
# Server-side (SSR / metadata) API base and the proxy target.
API_ORIGIN=http://localhost:4000
# Public site URL, used for Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
