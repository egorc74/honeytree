# Copy to .env for local development.
DATABASE_URL=postgresql://honeytree:honeytree@localhost:5432/honeytree
# Optional: enables response caching (leaderboard/feed) and a shared rate-limit store.
REDIS_URL=redis://localhost:6379
PORT=4000
HOST=0.0.0.0
# Comma separated list of web origins allowed by CORS and the CSRF origin check.
WEB_ORIGINS=http://localhost:3000
# Public URL of this API (used for placeholder image URLs).
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the object storage bucket (MinIO locally, R2/CDN in production).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/honeytree
SESSION_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
