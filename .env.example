# Copy to `.env` for local development. Never commit `.env`.
NODE_ENV=development

# --- Ports (see PLAN.md 2.2) ---
WEB_PORT=3000
API_PORT=4000

# --- URLs ---
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Set to "true" so the web app uses MSW mocks instead of the real API.
NEXT_PUBLIC_USE_MOCKS=false

# --- PostgreSQL ---
POSTGRES_USER=honeytree
POSTGRES_PASSWORD=honeytree
POSTGRES_DB=honeytree
DATABASE_URL=postgresql://honeytree:honeytree@localhost:5432/honeytree
TEST_DATABASE_URL=postgresql://honeytree:honeytree@localhost:5432/honeytree_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, Cloudflare R2 or MinIO in production) ---
# Private bucket: original uploads and game builds. Only reachable through presigned URLs.
# Public bucket: processed images and video (WebP, MP4, posters) and avatars, readable by anyone.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=honeytree
S3_SECRET_ACCESS_KEY=honeytree-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRIVATE=honeytree-private
S3_BUCKET_PUBLIC=honeytree-public
# Base URL browsers use to load files from the public bucket (no trailing slash).
S3_PUBLIC_BASE_URL=http://localhost:9000/honeytree-public
# Optional. Endpoint to sign presigned URLs for when browsers reach storage on a different
# host than the server does (for example inside Docker). Defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# --- MinIO (local only) ---
MINIO_ROOT_USER=honeytree
MINIO_ROOT_PASSWORD=honeytree-secret

# --- Malware scanning ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Mail (mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Auth / hashing ---
SESSION_SECRET=change-me-to-a-long-random-string
# Salt for hashing IPs in the downloads table. Change it in production.
IP_HASH_SALT=change-me-too

# --- Production only (infra/docker-compose.prod.yml) ---
SITE_DOMAIN=honeytree.example.com
ACME_EMAIL=ops@example.com

# --- Error tracking (optional). The API, web and worker all report to Sentry when set. ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Worker ---
# "fix" repairs drifted cached counters nightly; "report" only logs them.
COUNTER_RECHECK_MODE=fix
